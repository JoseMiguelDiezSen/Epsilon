    @{
        var idUsuarioSesion = Context.Session.GetInt32("IdUsuario");
        var nombreSesion = Context.Session.GetString("Usuario");
        var emailSesion = Context.Session.GetString("Email");
        var telefonoSesion = Context.Session.GetString("Telefono");
        var fotoSesion = Context.Session.GetString("FotoPerfil");
        var estaAutenticado = !string.IsNullOrEmpty(nombreSesion);
        var rutaFotoActual = !string.IsNullOrEmpty(fotoSesion)
            ? "data:image/jpeg;base64," + fotoSesion
            : Url.Content("~/media/defaultUserImage.jpg");
    }

    @* MODAL LATERAL *@
    <div id="secectionBox">
            
        <div id="themeContainer">
                                
            @* Botón Cerrar *@
            <div id="hideme" class="themeTitle" onclick="toggleModalLateral(false)" style="cursor: pointer;">
                <span><i class="fa fa-user-circle me-1"></i> MI PERFIL</span>
                <span><i class="fa fa-times"></i> CERRAR</span>
            </div>

            <!-- Video / GIF superior (intacto) -->
            <video style="width:100%;height:135px;background-position: center;object-fit:cover;display:block;" autoplay muted loop>
                <source src="~/media/videos/Motion.mp4" type="video/mp4" />
            </video>

            @if (estaAutenticado)
            {
                <!-- Sección : DATOS USUARIO -->
                <div class="themeName"><i class="fa fa-id-card me-1"></i> DATOS DE USUARIO</div>

                <!-- Avatar con opción de cambiar foto haciendo clic directo en ella -->
                <div class="lateral-avatar-wrapper">
                    <label for="lateralFotoInput" class="lateral-avatar-label" title="Haz clic en la foto para cambiarla">
                        <img id="lateralAvatarImg" class="lateral-avatar-img" src="@rutaFotoActual" alt="Foto de perfil" />
                        <div class="lateral-avatar-overlay">
                            <i class="fa fa-camera"></i>
                            <span>Cambiar</span>
                        </div>
                        <span class="lateral-avatar-badge" title="Cambiar foto de perfil">
                            <i class="fa fa-camera"></i>
                        </span>
                    </label>
                    <input type="file" id="lateralFotoInput" name="foto" accept="image/*" style="display:none;" />
                </div>

                <!-- Formulario de edición rápida -->
                <form id="lateralProfileForm" class="lateral-profile-form" onsubmit="return guardarPerfilLateral(event);">
                    <div class="lateral-form-group">
                        <label><i class="fa fa-user"></i> Nombre</label>
                        <input type="text" id="lateralNombre" name="nombre" class="lateral-input" value="@nombreSesion" placeholder="Nombre completo" required />
                    </div>

                    <div class="lateral-form-group">
                        <label><i class="fa fa-envelope"></i> Correo</label>
                        <input type="email" id="lateralEmail" name="email" class="lateral-input" value="@emailSesion" placeholder="ejemplo@correo.com" />
                    </div>

                    <div class="lateral-form-group">
                        <label><i class="fa fa-phone"></i> Teléfono</label>
                        <input type="tel" id="lateralTelefono" name="telefono" class="lateral-input" value="@telefonoSesion" placeholder="Número de teléfono" />
                    </div>

                    <button type="submit" id="btnGuardarLateral" class="btn-lateral-save">
                        <i class="fa fa-save"></i> Guardar Cambios
                    </button>

                    <div id="lateralFeedback" class="lateral-feedback"></div>
                </form>
            }
            else
            {
                <!-- Estado sin sesión -->
                <div class="themeName"><i class="fa fa-lock me-1"></i> ACCESO</div>

                <div class="lateral-guest-box">
                    <div class="lateral-guest-icon">
                        <i class="fa fa-user-slash"></i>
                    </div>
                    <div class="lateral-guest-title">Sesión no iniciada</div>
                    <div class="lateral-guest-desc">Inicia sesión para ver y editar tu perfil.</div>
                    <a href="@(Url.Action("Index", "Login"))" class="btn-lateral-login">
                        <i class="fa fa-sign-in"></i> Iniciar Sesión
                    </a>
                </div>
            }

        </div>
        <!--Fin 'secectionBox'-->
    </div>

    <img id="themesBtn" src="@rutaFotoActual" onclick="toggleModalLateral(true)" style="height:80px; width:80px; position:fixed; top:88px; right:0; cursor:pointer; z-index:1040; object-fit:cover; border-top: 2px solid rgba(255,255,255,0.85); border-left: 2px solid rgba(255,255,255,0.85); border-bottom: 2px solid rgba(255,255,255,0.85); border-top-left-radius: 8px; border-bottom-left-radius: 8px; box-shadow: -3px 4px 12px rgba(0,0,0,0.35);" class="imgUserClass" title="@(estaAutenticado ? nombreSesion : "Iniciar sesión")" alt="Perfil" />

    @RenderSection("Modals", required: false)

    <script>window.webapp_root = '@Url.Content("~/")'</script>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)

    <input type="hidden" id="fotoUsuario" value="@fotoSesion" />

    @* Script para interacción y actualización del perfil lateral *@
    <script>
        // Función garantizada para abrir y cerrar el panel lateral
        function toggleModalLateral(abrir) {
            var box = document.getElementById('secectionBox');
            var btn = document.getElementById('themesBtn');
            if (!box) return;

            if (window.jQuery) {
                if (abrir) {
                    $(box).stop().animate({ right: '0px' }, 400);
                    if (btn) $(btn).stop().animate({ right: '-90px' }, 150);
                } else {
                    $(box).stop().animate({ right: '-999px' }, 400);
                    if (btn) $(btn).stop().animate({ right: '0px' }, 400);
                }
            } else {
                if (abrir) {
                    box.style.right = '0px';
                    if (btn) btn.style.right = '-90px';
                } else {
                    box.style.right = '-999px';
                    if (btn) btn.style.right = '0px';
                }
            }
        }
        window.toggleModalLateral = toggleModalLateral;

        // Delegación de eventos con jQuery
        if (window.jQuery) {
            $(document).on('click', '#themesBtn', function (e) {
                e.preventDefault();
                toggleModalLateral(true);
            });
            $(document).on('click', '#hideme', function (e) {
                e.preventDefault();
                toggleModalLateral(false);
            });
        }
        // Previsualización y subida automática al seleccionar una foto
        document.getElementById('lateralFotoInput')?.addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (event) {
                    var lateralAvatar = document.getElementById('lateralAvatarImg');
                    if (lateralAvatar) {
                        lateralAvatar.src = event.target.result;
                    }
                    var triggerBtn = document.getElementById('themesBtn');
                    if (triggerBtn) {
                        triggerBtn.src = event.target.result;
                    }
                };
                reader.readAsDataURL(file);

                // Subir y guardar automáticamente la foto en el servidor
                subirFotoLateralDirecta(file);
            }
        });

        // Función para guardar automáticamente la nueva foto al seleccionarla
        function subirFotoLateralDirecta(file) {
            var feedback = document.getElementById('lateralFeedback');
            if (feedback) {
                feedback.className = 'lateral-feedback';
                feedback.style.display = 'block';
                feedback.style.background = 'rgba(255, 255, 255, 0.2)';
                feedback.style.color = '#ffffff';
                feedback.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Guardando foto...';
            }

            var formData = new FormData();
            formData.append('foto', file);

            fetch('@Url.Action("ActualizarPerfilLateral", "Usuarios")', {
                method: 'POST',
                body: formData
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data.success) {
                    if (feedback) {
                        feedback.className = 'lateral-feedback success';
                        feedback.innerHTML = '<i class="fa fa-check"></i> ¡Foto de perfil actualizada!';
                        feedback.style.display = 'block';
                        setTimeout(function () {
                            $(feedback).fadeOut();
                        }, 3500);
                    }
                    if (data.fotoBase64) {
                        var nuevaRuta = 'data:image/jpeg;base64,' + data.fotoBase64;
                        var triggerBtn = document.getElementById('themesBtn');
                        if (triggerBtn) triggerBtn.src = nuevaRuta;
                        var lateralAvatar = document.getElementById('lateralAvatarImg');
                        if (lateralAvatar) lateralAvatar.src = nuevaRuta;
                    }
                } else {
                    if (feedback) {
                        feedback.className = 'lateral-feedback error';
                        feedback.textContent = data.message || 'No se pudo guardar la foto';
                        feedback.style.display = 'block';
                    }
                }
            })
            .catch(function (err) {
                if (feedback) {
                    feedback.className = 'lateral-feedback error';
                    feedback.textContent = 'Error al enviar la imagen';
                    feedback.style.display = 'block';
                }
            });
        }

        // Guardar cambios del perfil lateral vía AJAX
        function guardarPerfilLateral(e) {
            e.preventDefault();

            var btn = document.getElementById('btnGuardarLateral');
            var feedback = document.getElementById('lateralFeedback');
            var fileInput = document.getElementById('lateralFotoInput');
            var nombre = document.getElementById('lateralNombre').value;
            var email = document.getElementById('lateralEmail').value;
            var telefono = document.getElementById('lateralTelefono').value;

            var formData = new FormData();
            formData.append('nombre', nombre);
            formData.append('email', email);
            formData.append('telefono', telefono);

            if (fileInput && fileInput.files.length > 0) {
                formData.append('foto', fileInput.files[0]);
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Guardando...';
            feedback.style.display = 'none';

            fetch('@Url.Action("ActualizarPerfilLateral", "Usuarios")', {
                method: 'POST',
                body: formData
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-save"></i> Guardar Cambios';

                if (data.success) {
                    feedback.className = 'lateral-feedback success';
                    feedback.textContent = data.message || 'Cambios guardados con éxito';
                    feedback.style.display = 'block';

                    // Actualizar imagen del botón flotante lateral
                    if (data.fotoBase64) {
                        var nuevaRuta = 'data:image/jpeg;base64,' + data.fotoBase64;
                        var triggerBtn = document.getElementById('themesBtn');
                        if (triggerBtn) {
                            triggerBtn.src = nuevaRuta;
                        }
                        var lateralAvatar = document.getElementById('lateralAvatarImg');
                        if (lateralAvatar) {
                            lateralAvatar.src = nuevaRuta;
                        }
                    }

                    setTimeout(function () {
                        $(feedback).fadeOut();
                    }, 4000);
                } else {
                    feedback.className = 'lateral-feedback error';
                    feedback.textContent = data.message || 'Error al guardar los datos';
                    feedback.style.display = 'block';
                }
            })
            .catch(function (err) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-save"></i> Guardar Cambios';
                feedback.className = 'lateral-feedback error';
                feedback.textContent = 'Error de conexión con el servidor';
                feedback.style.display = 'block';
            });

            return false;
        }
    </script>


    <style>
        .logoContainer {
        box-shadow: inset 7px 7px 7px 7px rgba(0.1, 0.1, 0.0, 0.3);
        }
    </style>

</body>
