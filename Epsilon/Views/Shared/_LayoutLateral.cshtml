                <script>
                    (function () {
                        try {
                            var saved = JSON.parse(localStorage.getItem('sidebarState') || '{}');
                            var groups = document.querySelectorAll('.sidebar .nav-group');
                            for (var i = 0; i < groups.length; i++) {
                                var g = groups[i];
                                var hasActive = g.querySelector('.nav-link.active') !== null;
                                if (hasActive || saved[i] === true) {
                                    g.classList.add('expanded');
                                } else if (saved[i] === false) {
                                    g.classList.remove('expanded');
                                }
                            }
                        } catch (e) {}
                    })();
                </script>
            </div>
