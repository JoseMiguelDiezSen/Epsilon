@using Epsilon.ViewModels
@model ViewFormAgregarServicio

<form id="addServicio" method="post" asp-action="AgregarServicio" name="addServicio" onsubmit="return jqPostAddServicio(this);" style="border:1px solid gainsboro;padding:10px">

    <div class="row">
        @* NOMBRE SERVICIO *@
        <div class="mb-3 col-md-12">
            <label class="form-label">Nombre del Servicio</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-briefcase"></i></span>
                <input type="text" class="form-control" asp-for="NombreServicio" placeholder="Ej: Consultoría, Mantenimiento..." required />
            </div>
            <span asp-validation-for="NombreServicio" class="text-danger"></span>
        </div>

        @* DURACION *@
        <div class="mb-3 col-md-6">
            <label class="form-label">Duración (minutos)</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-clock"></i></span>
                <input type="number" class="form-control" asp-for="Duracion" min="5" step="5" required />
            </div>
            <span asp-validation-for="Duracion" class="text-danger"></span>
        </div>

        @* PRECIO *@
        <div class="mb-3 col-md-6">
            <label class="form-label">Precio (€)</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-euro-sign"></i></span>
                <input type="number" class="form-control" asp-for="Precio" step="0.01" min="0" required />
            </div>
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>

        @* COLOR *@
        <div class="mb-3 col-md-6">
            <label class="form-label">Color en Calendario</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-palette"></i></span>
                <input type="color" class="form-control form-control-color" asp-for="Color" value="#3788d8" title="Selecciona color" />
            </div>
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>
    </div>

    @* BOTONES *@
    <div class="text-center mt-3">
        <button id="btnAddServicio" type="submit" class="btn btn-outline-success m-2"><span class="fa fa-check"></span> Aceptar</button>
        <button id="btnCancelServicio" type="button" class="btn btn-outline-danger m-2" data-bs-dismiss="modal"><span class="fa fa-circle-xmark"> </span> Cancelar</button>
    </div>

</form>
