@using Epsilon.ViewModels
@model ViewFormAgregarMedico

<form id="updateMedico" method="post" asp-action="ModificarMedico" name="updateMedico" onsubmit="return jqPostUpdateMedico(this);" enctype="multipart/form-data" autocomplete="off">

    <input type="hidden" name="IdMedico" id="IdMedico" asp-for="IdMedico" value="@Model.IdMedico" />

    <div style="border:1px solid gainsboro;padding:15px;box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);background-color:white;">

        <div class="text-center" style="border-radius:100px;margin-bottom:20px;">
            <img class="previewFoto" src="@(Model.FotoBase64 ?? Url.Content("~/media/defaultUserImage.jpg"))" alt="Foto Médico" height="120" width="120" style="border-radius:100px;border:3px solid #0d6efd;padding:3px;object-fit:cover;" />
        </div>

        <div class="row">
            <!-- Primera columna -->
            <div class="col-md-6">
                @* NOMBRE *@
                <div class="mb-3">
                    <label class="label">Nombre del Médico</label>
                    <div class="input-group" id="inputNombreMedico">
                        <span class="input-group-text"><i class="fas fa-user-md"></i></span>
                        <input type="text" class="form-control" asp-for="NombreMedico" placeholder="Ingrese nombre completo" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);">
                    </div>
                </div>

                @* DNI *@
                <div class="mb-3">
                    <label class="label">DNI</label>
                    <div class="input-group" id="inputDNI">
                        <span class="input-group-text"><i class="fa fa-address-card"></i></span>
                        <input type="text" class="form-control" asp-for="DNI" placeholder="Ingrese DNI" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);">
                    </div>
                </div>

                @* TELEFONO *@
                <div class="mb-3">
                    <label class="label">Teléfono</label>
                    <div class="input-group" id="inputTelefono">
                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                        <input type="text" class="form-control" asp-for="Telefono" placeholder="Ingrese teléfono" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);">
                    </div>
                </div>

                @* CORREO ELECTRONICO *@
                <div class="mb-3">
                    <label class="label">Correo Electrónico</label>
                    <div class="input-group" id="inputEmail">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" class="form-control" asp-for="EMail" placeholder="Ingrese correo electrónico" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);">
                    </div>
                </div>

                @* CLINICA *@
                <div class="mb-3">
                    <label class="label">Clínica</label>
                    <div class="input-group" id="inputClinica">
                        <span class="input-group-text"><i class="fa-solid fa-hospital"></i></span>
                        <select class="form-control" asp-for="IdClinica" asp-items="@Model.Clinicas">
                            <option value="">-- Seleccione una Clínica --</option>
                        </select>
                    </div>
                </div>

                @* ACTIVO *@
                <div class="mb-3 mt-4">
                    <div class="form-check">
                        <input id="checkActivo" class="form-check-input" type="checkbox" asp-for="Activo" />
                        <label class="form-check-label" for="checkActivo">Médico Activo</label>
                    </div>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                @* Nº COLEGIADO *@
                <div class="mb-3">
                    <label class="label">Nº de Colegiado</label>
                    <div class="input-group" id="inputColegiado">
                        <span class="input-group-text"><i class="fa fa-id-badge"></i></span>
                        <input type="number" class="form-control" asp-for="NumeroColegiado" placeholder="Ingrese nº colegiado" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);">
                    </div>
                </div>

                @* ESPECIALIDAD *@
                <div class="mb-3">
                    <label class="label">Especialidad</label>
                    <div class="input-group" id="inputEspecialidad">
                        <span class="input-group-text"><i class="fa fa-stethoscope"></i></span>
                        <input type="text" class="form-control" asp-for="Especialidad" placeholder="Ingrese especialidad" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);">
                    </div>
                </div>

                @* FECHA CONTRATACION *@
                <div class="mb-3">
                    <label class="label">Fecha de Contratación</label>
                    <div class="input-group" id="inputFechaContratacion">
                        <span class="input-group-text"><i class="fa-solid fa-calendar"></i></span>
                        <input type="date" asp-for="FechaContratacion" class="form-control" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);">
                    </div>
                </div>

                @* FOTO *@
                <div class="mb-3">
                    <label class="label">Cambiar Fotografía</label>
                    <div class="input-group" id="inputFoto">
                        <input type="file" asp-for="Foto" class="form-control inputFoto" accept="image/*" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);">
                        <span class="input-group-text"><i class="fas fa-upload"></i></span>
                    </div>
                </div>

                @* OBSERVACIONES *@
                <div class="mb-3">
                    <label class="label">Observaciones</label>
                    <div class="input-group" id="inputObservaciones">
                        <span class="input-group-text"><i class="fas fa-comment"></i></span>
                        <textarea class="form-control" rows="2" asp-for="Observaciones" placeholder="Escriba observaciones adicionales" style="box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* BOTONES *@
    <div class="fa-pull-left pt-3">
        <button id="btnUpdateMedicoSubmit" type="submit" class="btn btn-outline-success"><span class="fa fa-check"></span> Aceptar</button>
        <button id="btnCancelUpdateMedico" type="button" class="btn btn-outline-danger" data-bs-dismiss="modal"><span class="fa fa-circle-xmark"></span> Cancelar</button>
    </div>
</form>
