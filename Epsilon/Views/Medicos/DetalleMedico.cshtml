@using Negocio.Persistencia.Modelos
@model DatosMedicos

@if (Model != null)
{
    <div style="margin-bottom:10px">
        <div style="text-decoration:underline;font-weight:bold;color:white;">Datos Personales y Profesionales del Médico</div>
    </div>

    <div class="row text-start" style="margin:10px;color:white;">
        <div class="col-md-3 mb-2">
            <label class="label text-info">Nombre:</label>
            <span class="ms-1">@Model.NombreMedico</span>
        </div>
        <div class="col-md-3 mb-2">
            <label class="label text-info">DNI:</label>
            <span class="ms-1">@Model.DNI</span>
        </div>
        <div class="col-md-3 mb-2">
            <label class="label text-info">Nº Colegiado:</label>
            <span class="ms-1">@Model.NumeroColegiado</span>
        </div>
        <div class="col-md-3 mb-2">
            <label class="label text-info">Especialidad:</label>
            <span class="ms-1">@Model.Especialidad</span>
        </div>
        <div class="col-md-3 mb-2">
            <label class="label text-info">Teléfono:</label>
            <span class="ms-1">@Model.Telefono</span>
        </div>
        <div class="col-md-3 mb-2">
            <label class="label text-info">Email:</label>
            <span class="ms-1">@Model.EMail</span>
        </div>
        <div class="col-md-3 mb-2">
            <label class="label text-info">Fecha Contratación:</label>
            <span class="ms-1">@Model.FechaContratacion</span>
        </div>
        <div class="col-md-3 mb-2">
            <label class="label text-info">Clínica:</label>
            <span class="ms-1">@Model.NombreClinica</span>
        </div>
        <div class="col-md-6 mb-2">
            <label class="label text-info">Observaciones:</label>
            <span class="ms-1">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "Sin observaciones" : Model.Observaciones)</span>
        </div>
        <div class="col-md-6 mb-2">
            <label class="label text-info">Estado:</label>
            <span class="ms-1">@(Model.Activo ? "Activo" : "Inactivo")</span>
        </div>
    </div>
}
else
{
    <div class="text-center text-white-50 p-2">No se encontraron detalles para este médico.</div>
}
