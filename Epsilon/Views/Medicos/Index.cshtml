@model MedicosViewModel

@{
    ViewData["Title"] = "Médicos";
}
@{
    ViewBag.LogoHeader = "JMDNegro.png";
}

<hr>
<h4 class="text-center"><span class="fa-solid fa-user-doctor"></span> Médicos <span class="fa-solid fa-user-doctor"></span></h4>
<hr>

<form id="id_Form" method="post" asp-action="FiltrarMedicos" onsubmit="return jqPostFiltrar(event, this)">

    <button type="button" style="background-color:black;margin-top:10px;border:1px solid deepskyblue;" class="accordion">
        <span class="fa fa-search" style="vertical-align:middle;color:white;margin-top:-5px;margin-right:5px;"></span>
        <span style="color:white">Buscador Médicos</span>
    </button>

    <div class="panel" style="border-bottom:1px solid deepskyblue;border-left:1px solid skyblue;border-right:1px solid deepskyblue; box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);background-color:darkslategray">
        <div class="form-group row" style="padding:10px;">
            @* Nombre *@
            <div class="col-md-3">
                <label class="label" style="color:white">Nombre</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user-md"></i></span>
                    <input type="text" class="form-control" name="NombreMedico" placeholder="Ingrese nombre">
                </div>
            </div>

            @* DNI *@
            <div class="col-md-2">
                <label class="label" style="color:white">DNI</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-address-card"></i></span>
                    <input type="text" class="form-control" name="DNI" placeholder="Ingrese DNI">
                </div>
            </div>

            @* Especialidad *@
            <div class="col-md-3">
                <label class="label" style="color:white">Especialidad</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-stethoscope"></i></span>
                    <input type="text" class="form-control" name="Especialidad" placeholder="Ingrese especialidad">
                </div>
            </div>

            @* Teléfono *@
            <div class="col-md-2">
                <label class="label" style="color:white">Teléfono</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                    <input type="text" class="form-control" name="Telefono" placeholder="Ingrese teléfono">
                </div>
            </div>

            @* Botón Búsqueda *@
            <div class="col-md-2">
                <button type="submit" style="float:left;height:32px;width:100px;margin-top:21.5px;" class="btn btn-sm btn-outline-light fa fa-pull-right" onclick="if (window.PaginadorPrincipal){ PaginadorPrincipal.destroy(); delete window.idPaginadorPrincipal;}">
                    <span class="fa fa-search"> BUSCAR</span>
                </button>
            </div>
        </div>
    </div>

    <input type="hidden" asp-for="PaginaActual" id="PaginaActual" />
    <input type="hidden" asp-for="RegistrosPorPagina" id="RegistrosPorPagina" />
    <input type="hidden" name="RegistrosPaginaActual" id="RegistrosPaginaActual" value="@Model.Medicos?.Count()" />
</form>

<div style="margin-top:10px;">
    <button id="btnAddMedico" type="button" style="margin-bottom:10px;" class="btn btn-sm btn-primary fa-pull-right" onclick="return jqGetModalAddMedico()"><span class="fa fa-plus"></span> Nuevo <b>Médico</b></button>
</div>

<div id="idResultadosFiltro" class="text-center" style="margin-top:10px;">
    @{
        await Html.RenderPartialAsync("TablaMedicos", Model.Medicos);
    }
</div>

@* Paginacion *@
<div id="idPaginadorPrincipal" class="text-center m-1">
    <a class="btn btn-sm btn-outline-primary PaginaAnterior" onclick="PaginadorPrincipal.paginaAnterior()">
        <i class="fa fa-angle-double-left" aria-hidden="true"></i>
    </a>
    <span class="m-2 TextoPaginacion" style="color:white;">@Model.PaginaActual</span>
    <a class="btn btn-sm btn-outline-primary PaginaSiguiente" onclick="PaginadorPrincipal.paginaSiguiente()">
        <i class="fa fa-angle-double-right" aria-hidden="true"></i>
    </a>
</div>

<br />

@section Styles {
    <link href="~/css/Medicos.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/js/plugins/draggable.js"></script>
    <script src="~/js/Paginador.js" asp-append-version="true"></script>
    <script src="~/js/Medicos.js" asp-append-version="true"></script>
}

@section Modals {
    @* Modal agregar médico *@
    <div class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-keyboard="false" id="addMedicoModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center"><i class="fa-solid fa-user-doctor"></i> Alta Médico</h5>
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Contenido dinámico -->
                </div>
            </div>
        </div>
    </div>

    @* Modal modificar médico *@
    <div class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-keyboard="false" id="updateMedicoModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center"><i class="fa-solid fa-user-doctor"></i> Modificar datos del Médico</h5>
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Contenido dinámico -->
                </div>
            </div>
        </div>
    </div>

    @* Modal eliminar médico *@
    <div class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-keyboard="false" id="deleteMedicoModal">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center"><i class="fa-solid fa-user-doctor"></i> Eliminar Médico</h5>
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Contenido dinámico -->
                </div>
            </div>
        </div>
    </div>
}

<script>
    var acc = document.getElementsByClassName("accordion");
    var i;

    for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
            this.classList.toggle("active");
            var panel = this.nextElementSibling;
            if (panel.style.display === "block") {
                panel.style.display = "none";
            } else {
                panel.style.display = "block";
            }
        });
    }
</script>
