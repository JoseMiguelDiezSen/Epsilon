@using Epsilon.ViewModels

@model IEnumerable<ViewMedicos>

<table class="table table-light table-hover table-group-divider table-responsive table-sm" id="tablaMedicos">
    <thead>
        @* Cabecera *@
        <tr>
            <th scope="col" class="text-center d-none" width="1%">#</th>
            <th scope="col" class="d-none">IDMEDICO</th>
            <th scope="col">MÉDICO</th>
            <th scope="col">DNI</th>
            <th scope="col">TELÉFONO</th>
            <th scope="col">Nº COLEGIADO</th>
            <th scope="col">ACTIVO</th>
            <th scope="col">F. CONTRATACIÓN</th>
            <th scope="col">CLÍNICA</th>
            <th scope="col">OPERACIONES</th>
        </tr>
    </thead>

    <tbody id="idBodyTable">

        @if (Model != null && Model.Any())
        {
            foreach (var medico in Model)
            {
                <tr id="idFilaMedico_@medico.IdMedico" class="text-center">
                    <td class="text-center d-none">
                        <span class="fa-solid fa-user-doctor"></span>
                    </td>
                    <td style="text-align:center" class="d-none"> @medico.IdMedico.ToString()</td>
                    <td style="text-align:center"> @medico.NombreMedico?.ToString()</td>
                    <td style="text-align:center"> @medico.DNI?.ToString()</td>
                    <td style="text-align:center"> @medico.Telefono?.ToString()</td>
                    <td style="text-align:center"> @medico.NumeroColegiado.ToString()</td>
                    <td>
                        <input id="checkActivo_@medico.IdMedico" type="checkbox" @(medico.Activo ? "checked=\"checked\"" : "") disabled />
                    </td>
                    <td style="text-align:center"> @medico.FechaContratacion</td>
                    <td style="text-align:center"> @medico.NombreClinica</td>

                    @* OPERACIONES *@
                    <td>
                        <div aria-label="Operaciones Médicos">

                            @* Boton Editar Médico *@
                            <a class="btn btn-sm btn-outline-primary" id="btnEditar_@medico.IdMedico" title="Editar Médico" onclick="return jqGetModalUpdateMedico(@(medico.IdMedico))">
                                <span class="fa fa-pencil"></span>
                            </a>

                            @* Boton Eliminar Médico *@
                            <button class="btn btn-sm btn-outline-danger" style="margin-left:5px;" id="btnEliminar_@medico.IdMedico" title="Eliminar Médico" onclick="return jqGetModalDeleteMedico(@medico.IdMedico)">
                                <span class="fa fa-circle-xmark"></span>
                            </button>

                            @* Boton Mostrar Detalle *@
                            <button class="btn btn-sm btn-outline-dark js-toggle-detail" data-id="@medico.IdMedico" style="margin-left:5px;" id="btnMostrarDetalle_@medico.IdMedico" title="Ver Detalles">
                                <i class="fa fa-angle-double-down" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">
                    <span class="text-black-50 m-2">(No hay resultados)</span>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    th {
        background-color: darkgrey;
    }

    /* Estilos para el detalle */
    .detail-row td {
        background-color: none;
        color: black;
        border: 1px solid #444 !important;
        border-top: none !important;
        box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.05);
        padding: 5px;
        transition: all 0.7s ease;
    }

    .detail-row td:hover {
        background-color: #0d6efd !important;
    }

    .detail-content {
        background-color: #3b3f44;
        color: #f8f9fa;
        padding: 12px;
        border-radius: 0 0 6px 6px;
        box-shadow: inset 0 0 6px rgba(255,255,255,0.05);
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    #tablaMedicos, #tablaPacientes {
        border: 1px solid;
        border-color: deepskyblue;
    }

    #tablaMedicos td,
    #tablaMedicos th {
        vertical-align: middle !important;
        padding-top: 0.6rem;
        padding-bottom: 0.6rem;
    }

    #tablaMedicos input[type="checkbox"] {
        cursor: not-allowed;
    }
</style>