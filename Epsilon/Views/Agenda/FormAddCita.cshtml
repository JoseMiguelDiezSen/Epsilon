@using Epsilon.ViewModels
@model ViewFormAgregarCita

@* Formulario modal para creación de nueva cita médica *@
<form id="addCitaForm" method="post" name="addCitaForm" onsubmit="return jqPostAddCita(this);">

    <div id="contenedorControles">
        <h4 class="text-center mb-4">
            <i class="fa-solid fa-calendar-plus text-success"></i> DATOS DE LA CITA
        </h4>

        <div class="row">
            <!-- Primera columna: Cliente, Personal y Servicio -->
            <div class="col-md-6">

                @* Cliente *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Cliente</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                        <select class="form-select" asp-for="IdCliente" asp-items="Model.ListaClientes" required>
                            <option value="">-- Seleccione un Cliente --</option>
                        </select>
                    </div>
                </div>

                @* CLÍNICA *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Clínica</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-hospital"></i></span>
                        <select class="form-select" id="selectClinicaAdd" asp-for="IdSede" asp-items="Model.ListaSedes" required onchange="jqFiltrarMedicosPorClinica('addCitaForm', this.value)">
                            <option value="">-- Seleccione una clínica --</option>
                        </select>
                    </div>
                </div>

                @* Personal *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Personal / Especialista</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-user-doctor"></i></span>
                        <select class="form-select" id="selectMedicoAdd" asp-for="IdEmpleado" required onchange="jqAutoseleccionarClinica('addCitaForm', this)">
                            <option value="">-- Seleccione un Personal --</option>
                            @if (Model.SedesDisponibles != null && Model.PersonalDisponible != null)
                            {
                                foreach (var c in Model.SedesDisponibles)
                                {
                                    var medicosDeClinica = Model.PersonalDisponible.Where(m => m.IdSede == c.IdSede).ToList();
                                    if (medicosDeClinica.Any())
                                    {
                                        <optgroup label="@c.NombreSede" data-IdSede="@c.IdSede">
                                            @foreach (var m in medicosDeClinica)
                                            {
                                                <option value="@m.IdEmpleado" data-clinica="@m.IdSede" selected="@(m.IdEmpleado == Model.IdEmpleado)">
                                                    @m.NombreEmpleado - @m.Puesto
                                                </option>
                                            }
                                        </optgroup>
                                    }
                                }
                                var sinClinica = Model.PersonalDisponible.Where(m => !m.IdSede.HasValue).ToList();
                                if (sinClinica.Any())
                                {
                                    <optgroup label="Sin clínica asignada" data-IdSede="0">
                                        @foreach (var m in sinClinica)
                                        {
                                            <option value="@m.IdEmpleado" data-clinica="" selected="@(m.IdEmpleado == Model.IdEmpleado)">
                                                @m.NombreEmpleado - @m.Puesto
                                            </option>
                                        }
                                    </optgroup>
                                }
                            }
                            else if (Model.ListaPersonal != null)
                            {
                                foreach (var item in Model.ListaPersonal)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                @* Servicio *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Servicio / Consulta</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-tooth"></i></span>
                        <select class="form-select" asp-for="IdServicio" asp-items="Model.ListaServicios" required>
                            <option value="">-- Seleccione un Servicio --</option>
                        </select>
                    </div>
                </div>

            </div>

            <!-- Segunda columna: Fechas y Observaciones -->
            <div class="col-md-6">

                @* FECHA Y HORA DE INICIO *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Fecha y Hora de Inicio</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-clock"></i></span>
                        <input type="datetime-local" class="form-control" asp-for="FechaInicio"
                               value="@Model.FechaInicio.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>

                @* FECHA Y HORA DE FIN *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Fecha y Hora de Fin</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-clock-rotate-left"></i></span>
                        <input type="datetime-local" class="form-control" asp-for="FechaFin"
                               value="@Model.FechaFin.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>

                @* OBSERVACIONES *@
                <div class="mb-3">
                    <label class="form-label fw-bold">Observaciones / Motivo</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-comment-medical"></i></span>
                        <textarea class="form-control" asp-for="Observaciones" rows="2" placeholder="Motivo de la consulta o notas..."></textarea>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* BOTONES DE ACCIÓN A LA IZQUIERDA (Estándar de la aplicación) *@
    <div class="fa-pull-left pt-3">
        <button id="btnAddCita" type="submit" class="btn btn-outline-success m-2">
            <span class="fa fa-check"></span> Aceptar
        </button>
        <button id="btnCancel" type="button" class="btn btn-outline-danger m-2" data-bs-dismiss="modal">
            <span class="fa fa-circle-xmark"></span> Cancelar
        </button>
    </div>
</form>

<script>
    setTimeout(function() {
        if (typeof jqFiltrarMedicosPorClinica === 'function') {
            var clinicaVal = $('#selectClinicaAdd').val();
            if (clinicaVal) {
                jqFiltrarMedicosPorClinica('addCitaForm', clinicaVal);
            }
        }
    }, 100);
</script>



