@using Epsilon.ViewModels
@model ViewFormAgregarCliente

<form id="addCliente" method="post" asp-action="AgregarCliente" name="addCliente" onsubmit="return jqPostAddCliente(this);">

    <div id="contenedorControles">

        <div class="row">

            <h3 class="text-center mb-5">DATOS DEL NUEVO CLIENTE</h3> 

            <!-- Primera columna -->
            @* NOMBRE *@
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="label">Nombre o Razón Social</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" class="form-control" asp-for="NombreCliente" placeholder="Ingrese nombre o empresa">
                    </div>
                </div>

                @* TELEFONO *@
                <div class="mb-3">
                    <label class="label">Teléfono</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                        <input type="text" class="form-control" asp-for="Telefono" name="Telefono" placeholder="Ingrese teléfono">
                    </div>
                </div>

                @* DIRECCION *@ 
                <div class="mb-3">
                    <label class="label">Dirección</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-map-pin"></i></span>
                        <input type="text" asp-for="Direccion" class="form-control" placeholder="Ingrese dirección">
                    </div>
                </div>

                @* FECHA ALTA *@
                <div class="mb-3" style="margin-top:20px;">
                    <label class="label">Fecha de Alta</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-calendar"></i></span>
                        <input type="date" asp-for="FechaAlta1" class="form-control">
                    </div>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">

                @* DNI / CIF *@
                <div class="mb-3">
                    <label class="label">DNI / CIF / NIF</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa fa-address-card" aria-hidden="true"></i></span>
                        <input type="text" class="form-control" asp-for="DNI" placeholder="Ingrese identificación fiscal">
                    </div>
                </div>

                @* CORREO ELECTRONICO *@
                <div class="mb-3">
                    <label class="label">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" class="form-control" asp-for="EMail" name="EMail" placeholder="Ingrese correo" value="@Model.EMail">
                    </div>
                </div>

                @* CIUDAD *@ 
                <div class="mb-3">
                    <label class="label">Ciudad</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-city"></i></span>
                        <input type="text" asp-for="Ciudad" class="form-control" placeholder="Ingrese ciudad">
                    </div>
                </div>

                @* OBSERVACIONES *@ 
                <div class="mb-3">
                    <label class="label">Observaciones</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-comment"></i></span>
                        <textarea class="form-control" rows="1" placeholder="Observaciones o notas" name="Observaciones"></textarea>
                    </div>
                </div>

                @* PREFERENTE *@
                <div class="mb-3" style="margin-top:50px !important;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="Preferente" id="checkAsegurado">
                        <label class="form-check-label" style="margin-left:10px;">CLIENTE PREFERENTE</label>
                    </div>
                </div>

            </div>
        </div>
    </div>
    @* BOTONES *@
    <div class="fa-pull-left">
        <button id="btnAddPaciente" type="submit" class="btn btn-outline-success m-2"><span class="fa fa-check"></span> Aceptar</button>
        <button id="btnCancel" type="button" class="btn btn-outline-danger m-2" data-bs-dismiss="modal"><span class="fa fa-circle-xmark"> </span> Cancelar</button>
    </div>
</form>

<style>
    #checkAsegurado {
        width: 20px !important;
        height: 20px !important;
        accent-color: black !important;
    }
</style>
