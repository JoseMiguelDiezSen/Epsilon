@using Epsilon.ViewModels
@model IEnumerable<ViewClientes>

<table class="table table-dark table-hover table-group-divider table-responsive table-sm" id="tablaPacientes">
    <thead>
        <tr>
            <th scope="col" class="text-center d-none" width="1%">#</th>
            <th scope="col" class="d-none">IDCLIENTE</th>
            <th scope="col">CLIENTE</th>
            <th scope="col">DNI / CIF</th>
            <th scope="col">TELÉFONO</th>
            <th scope="col">CIUDAD</th>
            <th scope="col">PREFERENTE</th>
            <th scope="col">F. ALTA</th>
            <th scope="col">Nº SERVICIOS</th>
            <th scope="col">OPERACIONES</th>
        </tr>
    </thead>

    <tbody id="idBodyTable">
        @if (Model != null && Model.Any())
        {
            foreach (var cliente in Model)
            {
                <tr id="idFilaPeriodo_" class="text-center">
                    <td class="text-center d-none">
                        <span class="fa-solid fa-users"></span>
                    </td>
                    <td style="text-align:center" class="d-none">@cliente.IdCliente</td>
                    <td style="text-align:center">@cliente.NombreCliente</td>
                    <td style="text-align:center">@cliente.DNI</td>
                    <td style="text-align:center">@cliente.Telefono</td>
                    <td style="text-align:center">@cliente.Ciudad</td>
                    <td>
                        <input id="checkAsegurado" type="checkbox" @(cliente.Preferente ? "checked=\"checked\"" : "") disabled />
                    </td>
                    <td style="text-align:center">@cliente.FechaAlta.ToShortDateString()</td>
                    <td style="text-align:center">@cliente.NumeroServicios</td>

                    @* OPERACIONES *@
                    <td>
                        <div aria-label="Basic Example">
                            @* Boton Editar Cliente *@
                            <a class="btn btn-sm btn-outline-primary" id="btnEditar" onclick="jqGetModalUpdateCliente(@(cliente.IdCliente))" title="Modificar">
                                <span class="fa fa-pencil"></span>
                            </a>

                            @* Boton Eliminar Cliente *@
                            <button class="btn btn-sm btn-outline-danger" style="margin-left:5px;" id="btnEliminar" onclick="jqGetModalDeleteCliente(@cliente.IdCliente)" title="Eliminar">
                                <span class="fa fa-circle-xmark"></span>
                            </button>

                            @* Boton Mostrar Detalle *@
                            <button class="btn btn-sm btn-outline-light js-toggle-detail" data-id="@cliente.IdCliente" style="margin-left:5px;" id="btnMostrarDetalle" title="Ver detalle">
                                <i class="fa fa-angle-double-down" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">
                    <span class="text-black-50 m-2">(No hay resultados)</span>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .detail-row td {
        background-color: none;
        color: black;
        border: 1px solid #444 !important;
        border-top: none !important;
        box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.05);
        padding: 5px;
        transition: all 0.7s ease;
    }
    .detail-row td:hover {
        background-color: deepskyblue !important;
    }
    .detail-content {
        background-color: #3b3f44;
        color: #f8f9fa;
        padding: 12px;
        border-radius: 0 0 6px 6px;
        box-shadow: inset 0 0 6px rgba(255,255,255,0.05);
        overflow: hidden;
        transition: max-height 0.3s ease;
    }
    #tablaPacientes {
        border: 1px solid;
        border-color: deepskyblue;
    }
    #tablaPacientes td,
    #tablaPacientes th {
        vertical-align: middle !important;
        padding-top: 0.6rem;
        padding-bottom: 0.6rem;
    }
    #tablaPacientes input[type="checkbox"] {
        cursor: not-allowed;
    }
</style>
