@{
    ViewData["Title"] = "Visor Dicom";
    ViewBag.LogoHeader = "blanco.transparente2.png";
    ViewBag.Theme = "theme-dark";
}

<!-- ENCABEZADO -->
<div class="rad-header">
    <h4>
        <i class="fa-solid fa-circle-radiation rad-icon-glow"></i>
        Radiología Clínica
        <i class="fa-solid fa-circle-radiation rad-icon-glow"></i>
    </h4>
</div>

<!-- ===================== BARRA DE CONTROLES SUPERIOR ===================== -->
<div class="row control-bar">
    <div class="col-md-12 control-wrapper">

        <!-- GRUPO 1: ZOOM +/- -->
        <div class="control-group">
            <button class="btn-rad-tool" id="zoomIn" title="Aumentar Zoom (+)">
                <i class="fa fa-plus"></i>
            </button>
            <button class="btn-rad-tool" id="zoomOut" title="Disminuir Zoom (-)">
                <i class="fa fa-minus"></i>
            </button>
        </div>

        <div class="control-divider"></div>

        <!-- GRUPO 2: BRILLO, CONTRASTE Y ESCALA -->
        <div class="control-group">
            <div class="slider-container" title="Ajustar Brillo">
                <span class="slider-label"><i class="fa-solid fa-sun text-warning"></i> Brillo</span>
                <input type="range" id="brightness" class="rad-range" min="-500" max="500" value="0">
            </div>

            <div class="slider-container" title="Ajustar Contraste">
                <span class="slider-label"><i class="fa-solid fa-circle-half-stroke text-info"></i> Contraste</span>
                <input type="range" id="contrast" class="rad-range" min="1" max="4000" value="4095">
            </div>

            <div class="slider-container" title="Ajustar Escala / Tamaño">
                <span class="slider-label"><i class="fa-solid fa-magnifying-glass text-success"></i> Escala</span>
                <input type="range" id="tamanio" class="rad-range" min="0" max="100" value="50">
            </div>
        </div>

        <div class="control-divider"></div>

        <!-- GRUPO 3: BLOQUEO DE CONTROLES -->
        <div class="control-group">
            <label class="switch" title="Bloquear / Desbloquear interacción del visor">
                <input type="checkbox" id="toggleBtn">
                <span class="slider"></span>
            </label>
            <span id="toggleState" title="Estado de bloqueo">🔓</span>
        </div>

        <div class="control-divider"></div>

        <!-- GRUPO 4: HERRAMIENTAS DE DIBUJO / MEDIDA -->
        <div class="control-group">
            <select id="toolMode" name="toolMode" class="form-select form-select-sm rad-select" style="width:190px;">
                <option value="none" selected>✋ Navegación (Pan)</option>
                <option value="point">📍 Punto</option>
                <option value="line">📏 Línea (Medición)</option>
                <option value="rectangle">⬛ Rectángulo</option>
            </select>
        </div>

        <div class="control-divider"></div>

        <!-- GRUPO 5: ACCIONES (LIMPIAR, RESET, FULLSCREEN) -->
        <div class="control-group">
            <button class="btn-rad-action btn-clear" id="limpiarDibujos" title="Borrar todas las anotaciones y dibujos">
                <i class="fa-solid fa-eraser"></i> <span>Limpiar</span>
            </button>
            <button class="btn-rad-action btn-reset" id="reset" title="Restablecer valores originales">
                <i class="fa fa-rotate-left"></i> <span>Reset</span>
            </button>
            <button class="btn-rad-action btn-fullscreen" id="abrirVisor" onclick="abrirVisorFullScreen()" title="Pantalla completa">
                <i class="fa fa-maximize"></i> <span>Pantalla Completa</span>
            </button>
        </div>

    </div>
</div>

<!-- ===================== CONTENEDOR 3 COLUMNAS ===================== -->
<div class="row">

    <!-- COLUMNA 1: THUMBNAILS / ESTUDIOS DEL PACIENTE -->
    <div class="col-md-2">
        <div class="rad-card">
            <div class="rad-card-title">
                <i class="fa-solid fa-images text-info"></i> Estudios DCM
            </div>
            <div class="thumbnails-container" id="thumbnailsList">
                <div class="thumbnail-item" data-dcm="/Media/Radiografias/5.dcm" data-code="R-00" data-date="05-09-2026">
                    <div class="thumbnail-icon-box">
                        <i class="fa-solid fa-x-ray"></i>
                    </div>
                    <div class="thumbnail-meta">
                        <div class="thumbnail-code">R-00</div>
                        <div class="thumbnail-date">05/09/2026</div>
                    </div>
                </div>

                <div class="thumbnail-item" data-dcm="/Media/Radiografias/6.dcm" data-code="R-00" data-date="05-09-2026">
                    <div class="thumbnail-icon-box">
                        <i class="fa-solid fa-x-ray"></i>
                    </div>
                    <div class="thumbnail-meta">
                        <div class="thumbnail-code">R-00 (Alt)</div>
                        <div class="thumbnail-date">05/09/2026</div>
                    </div>
                </div>

                <div class="thumbnail-item" data-dcm="/Media/Radiografias/7.dcm" data-code="R-01" data-date="17-03-2026">
                    <div class="thumbnail-icon-box">
                        <i class="fa-solid fa-x-ray"></i>
                    </div>
                    <div class="thumbnail-meta">
                        <div class="thumbnail-code">R-01</div>
                        <div class="thumbnail-date">17/03/2026</div>
                    </div>
                </div>

                <div class="thumbnail-item" data-dcm="/Media/Radiografias/2.dcm" data-code="R-02" data-date="21-03-2026">
                    <div class="thumbnail-icon-box">
                        <i class="fa-solid fa-x-ray"></i>
                    </div>
                    <div class="thumbnail-meta">
                        <div class="thumbnail-code">R-02</div>
                        <div class="thumbnail-date">21/03/2026</div>
                    </div>
                </div>

                <div class="thumbnail-item" data-dcm="/Media/Radiografias/3.dcm" data-code="R-03" data-date="27-05-2026">
                    <div class="thumbnail-icon-box">
                        <i class="fa-solid fa-x-ray"></i>
                    </div>
                    <div class="thumbnail-meta">
                        <div class="thumbnail-code">R-03</div>
                        <div class="thumbnail-date">27/05/2026</div>
                    </div>
                </div>

                <div class="thumbnail-item" data-dcm="/Media/Radiografias/4.dcm" data-code="R-04" data-date="05-09-2026">
                    <div class="thumbnail-icon-box">
                        <i class="fa-solid fa-x-ray"></i>
                    </div>
                    <div class="thumbnail-meta">
                        <div class="thumbnail-code">R-04</div>
                        <div class="thumbnail-date">05/09/2026</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="rad-card">
            <div class="rad-card-title">
                <i class="fa-solid fa-user-check text-primary"></i> Paciente
            </div>
            <div class="rad-info-row">
                <span class="rad-info-label">Nombre</span>
                <span class="rad-info-value">@Model.NombrePaciente</span>
            </div>
            <div class="rad-info-row mt-2">
                <span class="rad-info-label">Historial</span>
                <span class="rad-badge">@Model.NumeroConsultas consultas</span>
            </div>
        </div>
    </div>

    <!-- COLUMNA 2: VISOR DICOM PRINCIPAL -->
    <div class="col-md-8">
        <div class="viewer-wrapper">
            <!-- BARRA DE CONTROLES FLOTANTE EN PANTALLA COMPLETA -->
            <div class="fullscreen-floating-bar" id="fsFloatingBar">
                <div class="control-group">
                    <div class="slider-container" title="Ajustar Brillo">
                        <span class="slider-label"><i class="fa-solid fa-sun text-warning"></i> Brillo</span>
                        <input type="range" id="fs_brightness" class="rad-range" min="-500" max="500" value="0">
                    </div>

                    <div class="slider-container" title="Ajustar Contraste">
                        <span class="slider-label"><i class="fa-solid fa-circle-half-stroke text-info"></i> Contraste</span>
                        <input type="range" id="fs_contrast" class="rad-range" min="1" max="4000" value="2000">
                    </div>

                    <div class="slider-container" title="Ajustar Escala / Zoom">
                        <span class="slider-label"><i class="fa-solid fa-magnifying-glass text-success"></i> Escala</span>
                        <input type="range" id="fs_tamanio" class="rad-range" min="0" max="100" value="50">
                    </div>
                </div>

                <div class="control-divider"></div>

                <div class="control-group">
                    <select id="fs_toolMode" class="form-select form-select-sm rad-select" style="width:175px;" title="Herramientas de dibujo">
                        <option value="none" selected>✋ Navegación (Pan)</option>
                        <option value="point">📍 Punto</option>
                        <option value="line">📏 Línea (Medición)</option>
                        <option value="rectangle">⬛ Rectángulo</option>
                    </select>
                </div>

                <div class="control-divider"></div>

                <div class="control-group">
                    <button class="btn-rad-tool" id="fs_limpiarDibujos" title="Limpiar dibujos y anotaciones">
                        <i class="fa-solid fa-eraser"></i>
                    </button>
                    <button class="btn-rad-tool" id="fs_reset" title="Restablecer vista original (Reset)">
                        <i class="fa fa-rotate-left"></i>
                    </button>
                    <button class="btn-rad-tool" id="fs_exitBtn" title="Salir de Pantalla Completa" onclick="salirVisorFullScreen()">
                        <i class="fa-solid fa-compress"></i>
                    </button>
                </div>
            </div>

            <!-- HUD CLÍNICO -->
            <div class="hud-tag hud-top-left" id="hudPatient">PACIENTE: @Model.NombrePaciente.ToUpper()</div>
            <div class="hud-tag hud-top-right" id="hudStudy">ESTUDIO: SIN CARGAR</div>
            <div class="hud-tag hud-bottom-left" id="hudZoom">ZOOM: 100% | MODO: PAN</div>
            <div class="hud-tag hud-bottom-right" id="hudVOI">WC: -- | WW: --</div>

            <!-- SPINNER DE CARGA -->
            <div id="textoVisor">
                <i class="fa-solid fa-circle-notch fa-spin text-info"></i>
                <span id="textoVisorMsg">Cargando estudio DICOM...</span>
            </div>

            <!-- CANVAS DE CORNERSTONE -->
            <div id="dicomViewer"></div>
        </div>
    </div>

    <!-- COLUMNA 3: DATOS DEL PACIENTE Y SELECTORES -->
    <div class="col-md-2">
        <div class="rad-card">
            <div class="rad-card-title">
                <i class="fa-solid fa-id-card text-info"></i> Datos Paciente
            </div>
            <div class="rad-info-row">
                <span class="rad-info-label"><i class="fa-solid fa-user"></i> Nombre</span>
                <span class="rad-info-value">@Model.NombrePaciente</span>
            </div>
            <div class="rad-info-row mt-2">
                <span class="rad-info-label"><i class="fa-solid fa-list-ol"></i> Consultas</span>
                <span class="rad-info-value">@Model.NumeroConsultas</span>
            </div>
            <div class="rad-info-row mt-2">
                <span class="rad-info-label"><i class="fa-solid fa-notes-medical"></i> Observaciones</span>
                <span class="rad-info-value text-muted" style="font-size:0.78rem;">
                    @(string.IsNullOrWhiteSpace(Model.Observaciones) ? "Sin observaciones registradas." : Model.Observaciones)
                </span>
            </div>
            <div class="rad-info-row mt-2">
                <span class="rad-info-label"><i class="fa-regular fa-calendar-check"></i> Última Cita</span>
                <span class="rad-badge">@Model.FechaUltimaCita.ToShortDateString()</span>
            </div>
        </div>

        <div class="rad-card">
            <div class="rad-card-title">
                <i class="fa-solid fa-x-ray text-warning"></i> Selección DCM
            </div>

            <label class="rad-info-label mb-1" for="listadoRadiografias">
                <i class="fa-solid fa-file-medical"></i> Radiografía
            </label>
            <select name="ListadoRadiografias"
                    class="form-select form-select-sm rad-select w-100 mb-3"
                    id="listadoRadiografias">
                <option value="" selected disabled>(Seleccione estudio)</option>
                <option value="/Media/Radiografias/5.dcm">R-00 (05-09-2026)</option>
                <option value="/Media/Radiografias/6.dcm">R-00 Alt (05-09-2026)</option>
                <option value="/Media/Radiografias/7.dcm">R-01 (17-03-2026)</option>
                <option value="/Media/Radiografias/2.dcm">R-02 (21-03-2026)</option>
                <option value="/Media/Radiografias/3.dcm">R-03 (27-05-2026)</option>
                <option value="/Media/Radiografias/4.dcm">R-04 (05-09-2026)</option>
            </select>

            <label class="rad-info-label mb-1" for="Posicion">
                <i class="fa-solid fa-arrows-up-down-left-right"></i> Posición
            </label>
            <select name="posicionRadiografias"
                    class="form-select form-select-sm rad-select w-100"
                    id="Posicion">
                <option value="" selected disabled>(Seleccione posición)</option>
                <option value="2">Frontal</option>
                <option value="3">Lateral Izquierdo</option>
                <option value="4">Lateral Derecho</option>
                <option value="5">Inferior</option>
            </select>
        </div>
    </div>

</div>

<!-- BOTÓN VOLVER -->
<div style="margin-bottom:15px; margin-top:16px;">
    <a class="btn-back" href="/Pacientes">
        <i class="fa-solid fa-arrow-left"></i> Volver a Pacientes
    </a>
</div>

@section Scripts {
    <script src="/dicom/cornerstone.min.js"></script>
    <script src="/dicom/hammer.min.js"></script>
    <script src="/dicom/cornerstoneMath.min.js"></script>
    <script src="/dicom/cornerstoneTools.min.js"></script>
    <script src="/dicom/cornerstoneWADOImageLoader.bundle.min.js"></script>
    <script src="/dicom/dicomParser.min.js"></script>
    <script src="~/js/Radiologia.js" asp-append-version="true"></script>
}

@section Modals {
    <div class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-keyboard="false" id="modalRadiografia">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center">
                        <i class="fa fa-user-plus" aria-hidden="true"></i> Radiografía
                    </h5>
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Contenido dinámico si se requiere -->
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <link href="~/css/Radiologia.css" rel="stylesheet" asp-append-version="true" />
}