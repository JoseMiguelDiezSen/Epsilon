@model PersonalViewModel

@{
    ViewData["Title"] = "Personal";
}
@{
    ViewBag.LogoHeader = "JMDNegro.png";
}

<hr>
<h4 class="text-center"><span class="fa-solid fa-id-badge"></span> Personal / Empleados <span class="fa-solid fa-id-badge"></span></h4>
<hr>

<form id="id_Form" method="post" asp-action="FiltrarPersonal" onsubmit="return jqPostFiltrar(event, this)">

    <button type="button" style="background-color:black;margin-top:10px;border:1px solid deepskyblue;" class="accordion">
        <span class="fa fa-search" style="vertical-align:middle;color:white;margin-top:-5px;margin-right:5px;"></span>
        <span style="color:white">Buscador Personal</span>
    </button>

    <div class="panel" style="border-bottom:1px solid deepskyblue;border-left:1px solid skyblue;border-right:1px solid deepskyblue; box-shadow: inset 0 2px 6px rgba(220,220,220,0.65);background-color:darkslategray">
        <div class="form-group row" style="padding:10px;">
            @* Nombre *@
            <div class="col-md-3">
                <label class="label" style="color:white">Nombre</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user-tie"></i></span>
                    <input type="text" class="form-control" name="NombreEmpleado" placeholder="Ingrese nombre">
                </div>
            </div>

            @* DNI *@
            <div class="col-md-2">
                <label class="label" style="color:white">DNI</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-address-card"></i></span>
                    <input type="text" class="form-control" name="DNI" placeholder="Ingrese DNI">
                </div>
            </div>

            @* Puesto *@
            <div class="col-md-3">
                <label class="label" style="color:white">Puesto / Categoría</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-briefcase"></i></span>
                    <input type="text" class="form-control" name="Puesto" placeholder="Ingrese puesto">
                </div>
            </div>

            @* Teléfono *@
            <div class="col-md-2">
                <label class="label" style="color:white">Teléfono</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                    <input type="text" class="form-control" name="Telefono" placeholder="Ingrese teléfono">
                </div>
            </div>

            @* Botón Búsqueda *@
            <div class="col-md-2">
                <button type="submit" style="float:left;height:32px;width:100px;margin-top:21.5px;" class="btn btn-sm btn-outline-light fa fa-pull-right" onclick="if (window.PaginadorPrincipal){ PaginadorPrincipal.destroy(); delete window.idPaginadorPrincipal;}">
                    <span class="fa fa-search"> BUSCAR</span>
                </button>
            </div>
        </div>
    </div>

    <input type="hidden" asp-for="PaginaActual" id="PaginaActual" />
    <input type="hidden" asp-for="RegistrosPorPagina" id="RegistrosPorPagina" />
    <input type="hidden" name="RegistrosPaginaActual" id="RegistrosPaginaActual" value="@Model.Personal?.Count()" />
</form>

<div style="margin-top:10px;">
    <button id="AddMedico" type="button" style="margin-bottom:10px;" class="btn btn-sm btn-light fa-pull-right" onclick="return jqGetModalAddPersonal(this)">
        <span class="fa fa-plus"></span> Nuevo <b>Empleado</b>
    </button>
</div>

<div id="idResultadosFiltro" class="text-center" style="margin-top:10px;">
    @{
        await Html.RenderPartialAsync("TablaPersonal", Model.Personal);
    }
</div>

@* Paginación *@
<div id="idPaginadorPrincipal" class="text-center m-1">
    <a class="btn btn-sm btn-outline-primary PaginaAnterior" onclick="PaginadorPrincipal.paginaAnterior()">
        <i class="fa fa-angle-double-left" aria-hidden="true"></i>
    </a>
    <span class="m-2 TextoPaginacion" style="color:white;">@Model.PaginaActual</span>
    <a class="btn btn-sm btn-outline-primary PaginaSiguiente" onclick="PaginadorPrincipal.paginaSiguiente()">
        <i class="fa fa-angle-double-right" aria-hidden="true"></i>
    </a>
</div>

<br />

@section Styles {
    <link href="~/css/Medicos.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/plugins/draggable.js"></script>
    <script src="~/js/Paginador.js" asp-append-version="true"></script>
    <script src="~/js/Personal.js" asp-append-version="true"></script>
}

@section Modals {
    @* Modal agregar empleado *@
    <div class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-keyboard="false" id="addPersonalModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center"><i class="fa-solid fa-id-badge"></i> Alta Personal / Empleado</h5>
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    @* Modal modificar empleado *@
    <div class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-keyboard="false" id="updatePersonalModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center"><i class="fa-solid fa-id-badge"></i> Modificar datos del Empleado</h5>
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    @* Modal eliminar empleado *@
    <div class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-keyboard="false" id="deletePersonalModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center"><i class="fa-solid fa-id-badge"></i> Eliminar empleado</h5>
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>
}

<script>
    var acc = document.getElementsByClassName("accordion");
    for (var i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
            this.classList.toggle("active");
            var panel = this.nextElementSibling;
            panel.style.display = (panel.style.display === "block") ? "none" : "block";
        });
    }
</script>
